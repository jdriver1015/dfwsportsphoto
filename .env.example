# The shared booking backend (Supabase -> Project Settings -> API). Both are
# public by design: Vite builds them into the browser bundle for the
# /booking/<token> page. Use the publishable (or legacy anon) key, never the
# secret/service key. Set the same in Vercel -> Settings -> Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true in Vercel when dfwsportsphotography.com points here (see vite.config.ts).
ALLOW_INDEXING=
