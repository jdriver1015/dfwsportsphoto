# The shared booking backend (Supabase -> Project Settings -> API). Both are
# public by design: Vite builds them into the browser bundle for the
# /booking/<token> page. Use the publishable (or legacy anon) key, never the
# secret/service key. Set the same in Vercel -> Settings -> Environment Variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to true in Vercel when dfwsportsphotography.com points here (see vite.config.ts).
ALLOW_INDEXING=

# --- Booking requests (server-only; never VITE_-prefixed) ---------------------
# Where /api/book sends the emails (client confirmation + notice to the studio),
# through Resend. Leave unset and requests are still saved, just not emailed.
RESEND_API_KEY=
# One address, or several separated by commas.
CONTACT_TO=
# A sender on a domain verified in Resend, ideally a subdomain, e.g.
# DFW Sports Photography <bookings@send.dfwsportsphotography.com>
CONTACT_FROM=
# The public address of this site, used for the link in the client's email.
# Blank uses the address the request came in on.
SITE_URL=
# The EMC Portal's address, so the studio's email can link to the booking. Optional.
PORTAL_URL=
